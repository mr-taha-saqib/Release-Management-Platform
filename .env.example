# ── Atlassian (Jira + Confluence) ─────────────────────────────────────────────
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=your-api-token-here
ATLASSIAN_DOMAIN=https://yourcompany.atlassian.net

# ── Jira ──────────────────────────────────────────────────────────────────────
JIRA_PROJECT_KEY=ATLAS
JIRA_PROJECT_KEYS=ATLAS,BEACON,CIPHER,DELTA
JIRA_DEADLINE=2026-12-31
JIRA_HOURS_PER_WEEK=40

# ── Confluence ────────────────────────────────────────────────────────────────
CONFLUENCE_SPACE_KEY=ATLAS
CONFLUENCE_SPACE_KEYS=ATLAS,BEACON,CIPHER,DELTA

# ── ServiceNow ────────────────────────────────────────────────────────────────
SERVICENOW_INSTANCE=https://yourinstance.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=your-password-here

# ── Ollama (Local LLM) ────────────────────────────────────────────────────────
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434
